# QueueDrop automated TEST environment only.
# Copy values into .env.test.local or keep the same TEST-prefixed variables in
# your existing .env.local. Never put production credentials here.
QUEUEDROP_TEST_BASE_URL=https://YOUR_TEST_DEPLOYMENT.example.com
QUEUEDROP_TEST_SUPABASE_URL=https://YOUR_TEST_PROJECT.supabase.co
QUEUEDROP_TEST_SUPABASE_SERVICE_ROLE_KEY=YOUR_TEST_SERVICE_ROLE_KEY
QUEUEDROP_TEST_SUPABASE_ANON_KEY=YOUR_TEST_ANON_OR_PUBLISHABLE_KEY

# RLS isolation fixture: owner belongs to one TEST business while the UUID below
# points to a different TEST business that the owner must not be able to read.
E2E_OWNER_EMAIL=queuedrop.e2e.owner@example.com
E2E_OWNER_PASSWORD=YOUR_TEST_ONLY_PASSWORD
E2E_FORBIDDEN_BUSINESS_ID=00000000-0000-0000-0000-000000000000
