# Public app environment
NEXT_PUBLIC_APP_ENV=dev
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLIC_ANON_OR_PUBLISHABLE_KEY

# Server-only. Never expose through NEXT_PUBLIC_* and never commit real values.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# Optional SMS provider
SEMAPHORE_API_KEY=
SEMAPHORE_SENDER_NAME=

# Automated TEST environment only. Use isolated TEST credentials, never PROD.
QUEUEDROP_TEST_BASE_URL=https://test.example.com
QUEUEDROP_TEST_SUPABASE_URL=https://YOUR_TEST_PROJECT.supabase.co
QUEUEDROP_TEST_SUPABASE_SERVICE_ROLE_KEY=YOUR_TEST_SERVICE_ROLE_KEY
QUEUEDROP_TEST_SUPABASE_ANON_KEY=YOUR_TEST_ANON_KEY
E2E_FORBIDDEN_BUSINESS_ID=
E2E_OWNER_EMAIL=
E2E_OWNER_PASSWORD=

# SMS delivery (server only)
SEMAPHORE_API_KEY=
SEMAPHORE_SENDER_NAME=
SMS_DRY_RUN=true
SMS_DISPATCH_SECRET=

# Billing / PayMongo (server only except site URL)
NEXT_PUBLIC_SITE_URL=https://getqueuedrop.com
PAYMONGO_SECRET_KEY=
PAYMONGO_WEBHOOK_SECRET=

# Transactional email foundation (configure before commercial launch)
RESEND_API_KEY=
QUEUEDROP_EMAIL_FROM=QueueDrop <no-reply@getqueuedrop.com>
QUEUEDROP_SUPPORT_EMAIL=

# PayMongo recurring subscriptions (account capability must be enabled by PayMongo)
NEXT_PUBLIC_PAYMONGO_PUBLIC_KEY=
PAYMONGO_SUBSCRIPTIONS_ENABLED=false

# Production operations
# Vercel Cron sends this automatically as Authorization: Bearer <CRON_SECRET>.
CRON_SECRET=
QUEUEDROP_ANDROID_APK_URL=
