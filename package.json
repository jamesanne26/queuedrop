{
  "name": "queuedrop",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:unit",
    "test:unit": "node scripts/run-tests.mjs unit",
    "test:unit:watch": "node scripts/run-tests.mjs unit --watch",
    "test:unit:coverage": "node scripts/run-tests.mjs unit --coverage",
    "test:integration": "node scripts/run-tests.mjs integration",
    "test:smoke": "node scripts/run-tests.mjs e2e/smoke",
    "quality": "npm run lint && npm run typecheck && npm run test:unit && npm run security:secrets",
    "verify": "npm run quality && npm run test:integration && npm run build",
    "security:secrets": "node scripts/check-secrets.mjs",
    "test:integration:required": "node scripts/run-tests.mjs integration --required",
    "test:smoke:required": "node scripts/run-tests.mjs e2e/smoke --required"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.112.3",
    "next": "16.3.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.2",
    "tailwindcss": "^4",
    "typescript": "^5",
    "@types/qrcode": "^1.5.6"
  }
}
